# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never exposed to client).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: HMAC-SHA256 secret used to sign user auth session tokens and OTP hashes on the server.
# Recommended: set a random 32+ character string in production.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ---- Email Delivery Provider (Required for Email OTP verification; fails closed if unset) ----
# Sender identity (required by Resend, SendGrid, and SMTP)
EMAIL_FROM="CV vs JD <noreply@example.com>"

# Option A: Resend API
RESEND_API_KEY=""

# Option B: SendGrid API
SENDGRID_API_KEY=""

# Option C: Standard SMTP (e.g. Postmark, SES, Mailgun, Google Workspace Relay)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ---- Shared OTP & Rate-Limit Storage ----
# Option 1: Redis (recommended for multi-instance production)
REDIS_URL=""

# Option 2: Firestore Admin SDK (uses firebase-applet-config.json projectId & firestoreDatabaseId)
# Optional in Cloud Run if Application Default Credentials have Firestore permissions.
FIREBASE_SERVICE_ACCOUNT_JSON=""

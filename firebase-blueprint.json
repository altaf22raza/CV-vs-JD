{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, retention preferences, and privacy metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth user ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional user avatar URL"
        },
        "retentionDays": {
          "type": "number",
          "description": "User-configured auto-purge retention days (0 = manual only)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "email"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Structured resume document with LaTeX source and optimization data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique resume ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "description": "Resume version title"
        },
        "targetRole": {
          "type": "string",
          "description": "Target job title for optimization"
        },
        "companyName": {
          "type": "string",
          "description": "Target company name"
        },
        "cvType": {
          "type": "string",
          "enum": ["uploaded", "created", "optimized"],
          "description": "Origin type of resume version"
        },
        "templateId": {
          "type": "string",
          "description": "Active template identifier"
        },
        "language": {
          "type": "string",
          "description": "ISO language code"
        },
        "latexSource": {
          "type": "string",
          "description": "Current LaTeX source code"
        },
        "originalLatex": {
          "type": "string",
          "description": "Original un-optimized LaTeX source code"
        },
        "jdText": {
          "type": "string",
          "description": "Target job description text"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp"
        },
        "isOriginal": {
          "type": "boolean",
          "description": "Whether this is a baseline master resume"
        }
      },
      "required": ["id", "userId", "title", "latexSource"]
    },
    "OptimizationHistory": {
      "title": "OptimizationHistory",
      "description": "Audit record of a Job Description analysis and optimization run",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "History item ID"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        },
        "resumeId": {
          "type": "string",
          "description": "Associated resume ID"
        },
        "targetRole": {
          "type": "string",
          "description": "Target job role"
        },
        "companyName": {
          "type": "string",
          "description": "Company name"
        },
        "scoreBefore": {
          "type": "number",
          "description": "Estimated alignment score before optimization"
        },
        "scoreAfter": {
          "type": "number",
          "description": "Estimated alignment score after optimization"
        },
        "createdAt": {
          "type": "string",
          "description": "Run timestamp"
        }
      },
      "required": ["id", "userId", "targetRole"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Tracked job application linked to a resume version",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique application ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "company": {
          "type": "string",
          "description": "Target employer name"
        },
        "role": {
          "type": "string",
          "description": "Job title applied for"
        },
        "status": {
          "type": "string",
          "enum": ["Saved", "Applied", "Interviewing", "Offer", "Rejected"],
          "description": "Current pipeline stage"
        },
        "resumeVersionId": {
          "type": "string",
          "description": "ID of resume version used"
        },
        "appliedDate": {
          "type": "string",
          "description": "Application date (YYYY-MM-DD)"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modified ISO timestamp"
        }
      },
      "required": ["id", "userId", "company", "role", "status"]
    },
    "ServerAuthOtp": {
      "title": "ServerAuthOtp",
      "description": "Server-only HMAC-hashed OTP records with strict expiration timestamps (no client SDK access)",
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "number",
          "description": "Unix epoch millisecond expiration timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Unix epoch millisecond update timestamp"
        }
      },
      "required": ["expiresAt"]
    },
    "ServerAuthRateLimit": {
      "title": "ServerAuthRateLimit",
      "description": "Server-only IP and email resend rate-limit windows (no client SDK access)",
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "number",
          "description": "Unix epoch millisecond expiration timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Unix epoch millisecond update timestamp"
        }
      },
      "required": ["expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profile documents"
    },
    "/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Collection of saved resume versions"
    },
    "/history/{historyId}": {
      "schema": "OptimizationHistory",
      "description": "Audit trail of JD optimizations"
    },
    "/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Collection of user job application tracker items"
    },
    "/auth_otps/{otpId}": {
      "schema": "ServerAuthOtp",
      "description": "Server-only collection for hashed OTP records (Admin SDK only)"
    },
    "/auth_rate_limits/{bucketId}": {
      "schema": "ServerAuthRateLimit",
      "description": "Server-only collection for IP and OTP resend rate limits (Admin SDK only)"
    }
  }
}
